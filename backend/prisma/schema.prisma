generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// 房间状态（仅四种）
enum RoomStatus {
  idle // 闲置中
  signing // 签约中
  leased // 租赁中
  terminating // 退租中
}

/// 用户角色
enum UserRole {
  admin // 工程师 / 管理员
  user // 普通用户
}

/// 用户状态
enum UserStatus {
  active // 启用
  disabled // 停用
}

/// 房间配置字典类型
enum RoomConfigType {
  size // 尺寸区间
  window // 窗户
  ac // 空调
}

/// 合约配置字典类型
enum ContractConfigType {
  periodType // 合约期类型（使用期 / 必须使用期 / 免租期等）
  leaseType // 租赁方式
  keyDeposit // 钥匙类按金单价（房门匙 / 智能卡信箱匙）
}

/// 系统用户
model User {
  /// 主键
  id           String     @id @default(cuid())
  /// 旧系统记录 ID（简道云 _id；工程师 JSON 导入用）
  legacyId     String?    @unique @map("legacy_id")
  /// 登录账号（手机号或系统账号）
  account      String     @unique
  /// 密码哈希（不可明文存储）
  passwordHash String     @map("password_hash")
  /// 显示名称
  displayName  String     @default("") @map("display_name")
  /// 角色：admin=管理员，user=普通用户
  role         UserRole   @default(user)
  /// 账号状态：active=启用，disabled=停用
  status       UserStatus @default(active)
  /// 联系电话
  phone        String     @default("")
  /// 邮箱
  email        String     @default("")
  /// 创建人用户 ID
  createdById  String?    @map("created_by")
  /// 创建人用户
  createdByUser User?     @relation("UserCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  /// 更新人用户 ID
  updatedById  String?    @map("updated_by")
  /// 更新人用户
  updatedByUser User?     @relation("UserUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  /// 创建时间
  createdAt    DateTime   @default(now()) @map("created_at")
  /// 更新时间
  updatedAt    DateTime   @updatedAt @map("updated_at")

  /// 作为创建人：下属用户
  createdUsers User[] @relation("UserCreatedBy")
  /// 作为更新人：下属用户
  updatedUsers User[] @relation("UserUpdatedBy")

  /// 作为创建人：房间配置
  createdRoomConfigOptions RoomConfigOption[] @relation("RoomConfigOptionCreatedBy")
  /// 作为更新人：房间配置
  updatedRoomConfigOptions RoomConfigOption[] @relation("RoomConfigOptionUpdatedBy")
  /// 作为创建人：房间类型
  createdRoomTypeOptions   RoomTypeOption[]   @relation("RoomTypeOptionCreatedBy")
  /// 作为更新人：房间类型
  updatedRoomTypeOptions   RoomTypeOption[]   @relation("RoomTypeOptionUpdatedBy")
  /// 作为创建人：客户来源
  createdCustomerSourceOptions CustomerSourceOption[] @relation("CustomerSourceOptionCreatedBy")
  /// 作为更新人：客户来源
  updatedCustomerSourceOptions CustomerSourceOption[] @relation("CustomerSourceOptionUpdatedBy")
  /// 作为创建人：大厦
  createdBuildings         Building[]         @relation("BuildingCreatedBy")
  /// 作为更新人：大厦
  updatedBuildings         Building[]         @relation("BuildingUpdatedBy")
  /// 作为创建人：房间
  createdRooms             Room[]             @relation("RoomCreatedBy")
  /// 作为更新人：房间
  updatedRooms             Room[]             @relation("RoomUpdatedBy")
  /// 作为创建人：房间图片
  createdRoomImages        RoomImage[]        @relation("RoomImageCreatedBy")
  /// 作为更新人：房间图片
  updatedRoomImages        RoomImage[]        @relation("RoomImageUpdatedBy")
  /// 作为创建人：客户
  createdCustomers         Customer[]         @relation("CustomerCreatedBy")
  /// 作为更新人：客户
  updatedCustomers         Customer[]         @relation("CustomerUpdatedBy")
  /// 作为客户经理：客户
  managedCustomers         Customer[]         @relation("CustomerAccountManager")
  /// 作为创建人：使用者
  createdOccupants         Occupant[]         @relation("OccupantCreatedBy")
  /// 作为更新人：使用者
  updatedOccupants         Occupant[]         @relation("OccupantUpdatedBy")
  /// 作为创建人：角色
  createdRoles             Role[]             @relation("RoleCreatedBy")
  /// 作为更新人：角色
  updatedRoles             Role[]             @relation("RoleUpdatedBy")
  /// 作为创建人：菜单
  createdMenus             Menu[]             @relation("MenuCreatedBy")
  /// 作为更新人：菜单
  updatedMenus             Menu[]             @relation("MenuUpdatedBy")
  /// 作为创建人：客户需求
  createdCustomerRequirements CustomerRequirement[] @relation("CustomerRequirementCreatedBy")
  /// 作为更新人：客户需求
  updatedCustomerRequirements CustomerRequirement[] @relation("CustomerRequirementUpdatedBy")
  /// 作为销售经理：客户需求
  salesManagedRequirements    CustomerRequirement[] @relation("CustomerRequirementSalesManager")
  /// 作为创建人：合约
  createdContracts            Contract[]            @relation("ContractCreatedBy")
  /// 作为更新人：合约
  updatedContracts            Contract[]            @relation("ContractUpdatedBy")
  /// 作为销售经理：合约
  salesManagedContracts       Contract[]            @relation("ContractSalesManager")
  /// 作为创建人：合约配置
  createdContractConfigOptions ContractConfigOption[] @relation("ContractConfigOptionCreatedBy")
  /// 作为更新人：合约配置
  updatedContractConfigOptions ContractConfigOption[] @relation("ContractConfigOptionUpdatedBy")
  /// 作为创建人：退租记录
  createdLeaseTerminations     LeaseTermination[]     @relation("LeaseTerminationCreatedBy")
  /// 作为更新人：退租记录
  updatedLeaseTerminations     LeaseTermination[]     @relation("LeaseTerminationUpdatedBy")
  /// 作为创建人：合约其他费用项
  createdContractOtherFees     ContractOtherFee[]     @relation("ContractOtherFeeCreatedBy")
  /// 作为更新人：合约其他费用项
  updatedContractOtherFees     ContractOtherFee[]     @relation("ContractOtherFeeUpdatedBy")
  /// 作为处理人：按金退还记录
  handledDepositRefunds        DepositRefund[]        @relation("DepositRefundHandler")
  /// 作为创建人：按金退还记录
  createdDepositRefunds        DepositRefund[]        @relation("DepositRefundCreatedBy")
  /// 作为更新人：按金退还记录
  updatedDepositRefunds        DepositRefund[]        @relation("DepositRefundUpdatedBy")
  /// 作为销售经理：发票
  salesManagedInvoices         Invoice[]              @relation("InvoiceSalesManager")
  /// 作为创建人：发票
  createdInvoices              Invoice[]              @relation("InvoiceCreatedBy")
  /// 作为更新人：发票
  updatedInvoices              Invoice[]              @relation("InvoiceUpdatedBy")
  /// 作为创建人：发票服务细节
  createdInvoiceServiceDetails InvoiceServiceDetail[] @relation("InvoiceServiceDetailCreatedBy")
  /// 作为更新人：发票服务细节
  updatedInvoiceServiceDetails InvoiceServiceDetail[] @relation("InvoiceServiceDetailUpdatedBy")
  /// 作为创建人：应收帐
  createdReceivables           Receivable[]           @relation("ReceivableCreatedBy")
  /// 作为更新人：应收帐
  updatedReceivables           Receivable[]           @relation("ReceivableUpdatedBy")
  /// 作为创建人：收据
  createdReceipts              Receipt[]              @relation("ReceiptCreatedBy")
  /// 作为更新人：收据
  updatedReceipts              Receipt[]              @relation("ReceiptUpdatedBy")
  /// 作为创建人：单据打印模板
  createdDocumentTemplates     DocumentTemplate[]     @relation("DocumentTemplateCreatedBy")
  /// 作为更新人：单据打印模板
  updatedDocumentTemplates     DocumentTemplate[]     @relation("DocumentTemplateUpdatedBy")
  /// 作为创建人：自动编号规则
  createdNumberingRules        NumberingRule[]        @relation("NumberingRuleCreatedBy")
  /// 作为更新人：自动编号规则
  updatedNumberingRules        NumberingRule[]        @relation("NumberingRuleUpdatedBy")

  @@index([status])
  @@index([role])
  @@index([createdById])
  @@index([updatedById])
  @@map("users")
}

/// 房间配置字典：尺寸区间 / 窗户 / 空调
model RoomConfigOption {
  /// 主键
  id        String         @id @default(cuid())
  /// 旧系统记录 ID（简道云 _id；工程师 JSON 导入用）
  legacyId  String?        @unique @map("legacy_id")
  /// 配置类型：size / window / ac
  type      RoomConfigType
  /// 配置描述（展示用标签）
  label     String
  /// 尺寸下限（平方呎，含下限；仅 size 类型使用）
  minSqft   Decimal?       @map("min_sqft") @db.Decimal(12, 2)
  /// 尺寸上限（平方呎，不含上限；仅 size 类型使用）
  maxSqft   Decimal?       @map("max_sqft") @db.Decimal(12, 2)
  /// 空调品牌（仅 ac 类型可选）
  brand     String         @default("")
  /// 空调型号（仅 ac 类型可选）
  model     String         @default("")
  /// 排序权重，越小越靠前
  sortOrder Int            @default(0) @map("sort_order")
  /// 是否启用（停用后表单不下拉展示）
  active    Boolean        @default(true)
  /// 创建人用户 ID
  createdById String?      @map("created_by")
  /// 创建人用户
  createdByUser User?      @relation("RoomConfigOptionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  /// 更新人用户 ID
  updatedById String?      @map("updated_by")
  /// 更新人用户
  updatedByUser User?      @relation("RoomConfigOptionUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  /// 创建时间
  createdAt DateTime       @default(now()) @map("created_at")
  /// 更新时间
  updatedAt DateTime       @updatedAt @map("updated_at")

  /// 作为房间大小：客户需求
  sizeRequirements   CustomerRequirement[] @relation("CustomerRequirementSizeConfig")
  /// 作为空调：客户需求
  acRequirements     CustomerRequirement[] @relation("CustomerRequirementAcConfig")
  /// 作为窗：客户需求
  windowRequirements CustomerRequirement[] @relation("CustomerRequirementWindowConfig")

  @@index([type, active])
  @@index([type, sortOrder])
  @@index([createdById])
  @@index([updatedById])
  @@map("room_config_options")
}

/// 房间类型字典（办公室 / 會議室等，可后台维护）
model RoomTypeOption {
  /// 主键
  id        String   @id @default(cuid())
  /// 类型名称（业务唯一，写入房间 room_type）
  label     String   @unique
  /// 展示色系：office / meeting / desk / studio / other
  tone      String   @default("other")
  /// 表单选择时的简短说明
  hint      String   @default("")
  /// 排序权重，越小越靠前
  sortOrder Int      @default(0) @map("sort_order")
  /// 是否启用
  active    Boolean  @default(true)
  /// 创建人用户 ID
  createdById String? @map("created_by")
  /// 创建人用户
  createdByUser User? @relation("RoomTypeOptionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  /// 更新人用户 ID
  updatedById String? @map("updated_by")
  /// 更新人用户
  updatedByUser User? @relation("RoomTypeOptionUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  /// 创建时间
  createdAt DateTime @default(now()) @map("created_at")
  /// 更新时间
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([active, sortOrder])
  @@index([createdById])
  @@index([updatedById])
  @@map("room_type_options")
}

/// 客户来源字典（Agent / Call in 等，可后台维护）
model CustomerSourceOption {
  /// 主键
  id          String   @id @default(cuid())
  /// 来源名称（业务唯一，写入客户 source）
  label       String   @unique
  /// 排序权重，越小越靠前
  sortOrder   Int      @default(0) @map("sort_order")
  /// 是否启用
  active      Boolean  @default(true)
  /// 创建人用户 ID
  createdById String?  @map("created_by")
  /// 创建人用户
  createdByUser User?  @relation("CustomerSourceOptionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  /// 更新人用户 ID
  updatedById String?  @map("updated_by")
  /// 更新人用户
  updatedByUser User?  @relation("CustomerSourceOptionUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  /// 创建时间
  createdAt   DateTime @default(now()) @map("created_at")
  /// 更新时间
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([active, sortOrder])
  @@index([createdById])
  @@index([updatedById])
  @@map("customer_source_options")
}

/// 大厦信息
model Building {
  /// 主键
  id                String   @id @default(cuid())
  /// 旧系统记录 ID（简道云 _id；工程师 JSON 导入用）
  legacyId          String?  @unique @map("legacy_id")
  /// 大厦名称
  name              String
  /// 地址（中文）
  address           String   @default("")
  /// 地址（英文）
  addressEn         String   @default("") @map("address_en")
  /// 负责人
  manager           String   @default("")
  /// 负责人电话
  managerPhone      String   @default("") @map("manager_phone")
  /// 协议书模板 ID（绑定单据模板库）
  agreementTemplateId String? @map("agreement_template_id")
  /// 协议书模板
  agreementTemplateRef DocumentTemplate? @relation("BuildingAgreementTemplate", fields: [agreementTemplateId], references: [id], onDelete: SetNull)
  /// API 模板名称后缀
  apiTemplateSuffix String?  @map("api_template_suffix")
  /// 大厦邮箱
  email             String   @default("")
  /// 工作时间
  workingHours      String   @default("") @map("working_hours")
  /// 发票模板 ID（绑定单据模板库）
  invoiceTemplateId String?  @map("invoice_template_id")
  /// 发票模板
  invoiceTemplateRef DocumentTemplate? @relation("BuildingInvoiceTemplate", fields: [invoiceTemplateId], references: [id], onDelete: SetNull)
  /// FPS 收款标识
  fpsId             String?  @map("fps_id")
  /// 银行户主名称
  bankAccountHolder String?  @map("bank_account_holder")
  /// 大厦银行账户
  bankAccount       String?  @map("bank_account")
  /// 支票付款抬头
  chequePaymentBy   String?  @map("cheque_payment_by")
  /// 付款提示 / Payment Advice
  paymentAdvice     String?  @map("payment_advice")
  /// 收据模板 ID（绑定单据模板库）
  receiptTemplateId String?  @map("receipt_template_id")
  /// 收据模板
  receiptTemplateRef DocumentTemplate? @relation("BuildingReceiptTemplate", fields: [receiptTemplateId], references: [id], onDelete: SetNull)
  /// 是否使用 WBA_NUMBER
  useWbaNumber      String?  @map("use_wba_number")
  /// 是否启用（停用后不出现在房间快捷胶囊等）
  active            Boolean  @default(true)
  /// 创建人用户 ID
  createdById       String?  @map("created_by")
  /// 创建人用户
  createdByUser     User?    @relation("BuildingCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  /// 更新人用户 ID
  updatedById       String?  @map("updated_by")
  /// 更新人用户
  updatedByUser     User?    @relation("BuildingUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  /// 创建时间
  createdAt         DateTime @default(now()) @map("created_at")
  /// 更新时间
  updatedAt         DateTime @updatedAt @map("updated_at")
  /// 下属房间
  rooms             Room[]
  /// 关联客户
  customers         Customer[]

  @@index([active])
  @@index([createdById])
  @@index([updatedById])
  @@index([agreementTemplateId])
  @@index([invoiceTemplateId])
  @@index([receiptTemplateId])
  @@map("buildings")
}

/// 房间信息
model Room {
  /// 主键
  id              String     @id @default(cuid())
  /// 旧系统记录 ID（简道云 _id；工程师 JSON 导入用）
  legacyId        String?    @unique @map("legacy_id")
  /// 房间编号（业务唯一）
  roomCode        String     @unique @map("room_code")
  /// 房间名称
  name            String
  /// 房间类型（如办公室、会议室等）
  roomType        String     @default("") @map("room_type")
  /// 所属大厦 ID
  buildingId      String     @map("building_id")
  /// 所属大厦
  building        Building   @relation(fields: [buildingId], references: [id], onDelete: Restrict)
  /// 房间状态：idle=闲置中，signing=签约中，leased=租赁中，terminating=退租中
  status          RoomStatus @default(idle)
  /// 内部序号 / 流水号
  serialNo        String     @default("") @map("serial_no")
  /// 月租
  monthlyRent     Decimal    @default(0) @map("monthly_rent") @db.Decimal(12, 2)
  /// 日租
  dailyRent       Decimal    @default(0) @map("daily_rent") @db.Decimal(12, 2)
  /// 时租
  hourlyRent      Decimal    @default(0) @map("hourly_rent") @db.Decimal(12, 2)
  /// 房间呎寸（平方呎）
  sizeSqft        Decimal    @default(0) @map("size_sqft") @db.Decimal(12, 2)
  /// 房间描述
  description     String?
  /// 备注
  remark          String?
  /// 窗户配置
  windowConfig    String?    @map("window_config")
  /// 空调配置
  acConfig        String?    @map("ac_config")
  /// 最新合约标识 / 编号
  latestContract  String?    @map("latest_contract")
  /// 历史合约记录列表
  contractRecords String[]   @default([]) @map("contract_records")
  /// 创建人用户 ID
  createdById     String?    @map("created_by")
  /// 创建人用户
  createdByUser   User?      @relation("RoomCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  /// 更新人用户 ID
  updatedById     String?    @map("updated_by")
  /// 更新人用户
  updatedByUser   User?      @relation("RoomUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  /// 分租标记
  subleaseMark    String?    @map("sublease_mark")
  /// 创建时间
  createdAt       DateTime   @default(now()) @map("created_at")
  /// 更新时间
  updatedAt       DateTime   @updatedAt @map("updated_at")
  /// 下属合约
  contracts       Contract[] @relation("ContractBelongsToRoom")
  /// 下属退租记录
  leaseTerminations LeaseTermination[] @relation("LeaseTerminationBelongsToRoom")
  /// 下属按金退还记录
  depositRefunds    DepositRefund[]    @relation("DepositRefundBelongsToRoom")
  /// 下属发票
  invoices          Invoice[]          @relation("InvoiceBelongsToRoom")
  /// 下属房间图片
  images            RoomImage[]        @relation("RoomImageBelongsToRoom")

  @@index([buildingId])
  @@index([status])
  @@index([createdById])
  @@index([updatedById])
  @@map("rooms")
}

/// 房间图片（一房间多图，不限数量）
model RoomImage {
  /// 主键
  id          String   @id @default(cuid())
  /// 所属房间 ID
  roomId      String   @map("room_id")
  /// 所属房间
  room        Room     @relation("RoomImageBelongsToRoom", fields: [roomId], references: [id], onDelete: Cascade)
  /// 原始文件名
  fileName    String   @map("file_name")
  /// 存储相对路径（相对 uploads 根目录；或以 /、http 开头的公开/外部地址）
  storageKey  String   @map("storage_key")
  /// 展示排序（越小越靠前）
  sortOrder   Int      @default(0) @map("sort_order")
  /// 创建人用户 ID
  createdById String?  @map("created_by")
  /// 创建人用户
  createdByUser User?  @relation("RoomImageCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  /// 更新人用户 ID
  updatedById String?  @map("updated_by")
  /// 更新人用户
  updatedByUser User?  @relation("RoomImageUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  /// 创建时间
  createdAt   DateTime @default(now()) @map("created_at")
  /// 更新时间
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([roomId, sortOrder])
  @@index([createdById])
  @@index([updatedById])
  @@map("room_images")
}

/// 客户（咨询/签约主体；一个客户可对应多名使用者）
model Customer {
  /// 主键
  id               String     @id @default(cuid())
  /// 旧系统记录 ID（简道云 _id；工程师 JSON 导入用）
  legacyId         String?    @unique @map("legacy_id")
  /// 客户编号（业务唯一，如 CSM260485）
  customerCode     String     @unique @map("customer_code")
  /// 客户名称
  name             String
  /// 状态：新客戶 / 已查詢 / 簽約中 / 租賃中 / 退租中 / 已退租 等
  status           String     @default("")
  /// 客户经理用户 ID
  accountManagerId String?    @map("account_manager")
  /// 客户经理用户
  accountManagerUser User?    @relation("CustomerAccountManager", fields: [accountManagerId], references: [id], onDelete: SetNull)
  /// 公司名称（中文）
  companyNameZh    String     @default("") @map("company_name_zh")
  /// 公司名称（英文）
  companyNameEn    String     @default("") @map("company_name_en")
  /// 商业登记号码
  businessRegNo    String     @default("") @map("business_reg_no")
  /// 业务性质
  businessNature   String     @default("") @map("business_nature")
  /// 商业登记副本路径
  businessRegCopy  String     @default("") @map("business_reg_copy")
  /// 备注
  remark           String     @default("")
  /// 客户来源
  source           String     @default("")
  /// 在租房间（文本，如 SP60；后续可挂 Room）
  rentedRooms      String     @default("") @map("rented_rooms")
  /// 所属大厦 ID
  buildingId       String?    @map("building_id")
  /// 所属大厦
  building         Building?  @relation(fields: [buildingId], references: [id], onDelete: SetNull)
  /// 主要使用者（联络人）ID
  primaryOccupantId String?   @map("primary_occupant_id")
  /// 主要使用者（联络人）
  primaryOccupant  Occupant?  @relation("CustomerPrimaryOccupant", fields: [primaryOccupantId], references: [id], onDelete: SetNull)
  /// 协议打印模板覆盖 ID（空则用所属大厦绑定的协议模板）
  agreementTemplateId String? @map("agreement_template_id")
  /// 协议打印模板覆盖
  agreementTemplate DocumentTemplate? @relation("CustomerAgreementTemplate", fields: [agreementTemplateId], references: [id], onDelete: SetNull)
  /// 创建人用户 ID
  createdById      String?    @map("created_by")
  /// 创建人用户
  createdByUser    User?      @relation("CustomerCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  /// 更新人用户 ID
  updatedById      String?    @map("updated_by")
  /// 更新人用户
  updatedByUser    User?      @relation("CustomerUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  /// 创建时间
  createdAt        DateTime   @default(now()) @map("created_at")
  /// 更新时间
  updatedAt        DateTime   @updatedAt @map("updated_at")
  /// 下属使用者（实际租赁名义人）
  occupants        Occupant[] @relation("OccupantBelongsToCustomer")
  /// 下属客户需求
  requirements     CustomerRequirement[] @relation("CustomerRequirementBelongsToCustomer")
  /// 下属合约
  contracts        Contract[]            @relation("ContractBelongsToCustomer")
  /// 下属退租记录
  leaseTerminations LeaseTermination[]   @relation("LeaseTerminationBelongsToCustomer")
  /// 下属按金退还记录
  depositRefunds    DepositRefund[]      @relation("DepositRefundBelongsToCustomer")
  /// 下属发票
  invoices          Invoice[]            @relation("InvoiceBelongsToCustomer")
  /// 下属应收帐
  receivables       Receivable[]         @relation("ReceivableBelongsToCustomer")
  /// 下属收据
  receipts          Receipt[]            @relation("ReceiptBelongsToCustomer")

  @@index([status])
  @@index([name])
  @@index([accountManagerId])
  @@index([buildingId])
  @@index([primaryOccupantId])
  @@index([agreementTemplateId])
  @@index([createdById])
  @@index([updatedById])
  @@map("customers")
}

/// 客户需求（咨询阶段的租房意向）
model CustomerRequirement {
  /// 主键
  id               String    @id @default(cuid())
  /// 旧系统记录 ID（简道云 _id；工程师 JSON 导入用）
  legacyId         String?   @unique @map("legacy_id")
  /// 需求编号（业务唯一，如 REQ2609100001）
  requirementCode  String    @unique @map("requirement_code")
  /// 所属客户 ID
  customerId       String    @map("customer_id")
  /// 所属客户
  customer         Customer  @relation("CustomerRequirementBelongsToCustomer", fields: [customerId], references: [id], onDelete: Cascade)
  /// 销售经理用户 ID
  salesManagerId   String?   @map("sales_manager")
  /// 销售经理用户
  salesManagerUser User?     @relation("CustomerRequirementSalesManager", fields: [salesManagerId], references: [id], onDelete: SetNull)
  /// 创建日期（业务日期）
  requirementDate  DateTime? @map("requirement_date") @db.Date
  /// 状态：跟進中 / 已簽約 / 已取消
  status           String    @default("跟進中")
  /// 租赁时长（文本，如 12个月）
  leaseDuration    String    @default("") @map("lease_duration")
  /// 预算
  budget           Decimal?  @db.Decimal(14, 2)
  /// 需求内容
  content          String    @default("")
  /// 备注
  remark           String    @default("")
  /// 附件路径
  attachment       String    @default("")
  /// 房间大小配置 ID（房间配置 size）
  sizeConfigId     String?   @map("size_config_id")
  /// 房间大小配置
  sizeConfig       RoomConfigOption? @relation("CustomerRequirementSizeConfig", fields: [sizeConfigId], references: [id], onDelete: SetNull)
  /// 空调配置 ID（房间配置 ac）
  acConfigId       String?   @map("ac_config_id")
  /// 空调配置
  acConfig         RoomConfigOption? @relation("CustomerRequirementAcConfig", fields: [acConfigId], references: [id], onDelete: SetNull)
  /// 窗配置 ID（房间配置 window）
  windowConfigId   String?   @map("window_config_id")
  /// 窗配置
  windowConfig     RoomConfigOption? @relation("CustomerRequirementWindowConfig", fields: [windowConfigId], references: [id], onDelete: SetNull)
  /// 创建人用户 ID
  createdById      String?   @map("created_by")
  /// 创建人用户
  createdByUser    User?     @relation("CustomerRequirementCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  /// 更新人用户 ID
  updatedById      String?   @map("updated_by")
  /// 更新人用户
  updatedByUser    User?     @relation("CustomerRequirementUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  /// 创建时间
  createdAt        DateTime  @default(now()) @map("created_at")
  /// 更新时间
  updatedAt        DateTime  @updatedAt @map("updated_at")
  /// 关联合约
  contracts        Contract[] @relation("ContractBelongsToRequirement")

  @@index([customerId])
  @@index([salesManagerId])
  @@index([status])
  @@index([requirementDate])
  @@index([sizeConfigId])
  @@index([acConfigId])
  @@index([windowConfigId])
  @@index([createdById])
  @@index([updatedById])
  @@map("customer_requirements")
}

/// 租赁合约（房间与客户的签约主体）
model Contract {
  /// 主键
  id                  String    @id @default(cuid())
  /// 旧系统记录 ID（简道云 _id；工程师 JSON 导入用）
  legacyId            String?   @unique @map("legacy_id")
  /// 合约编号（业务唯一，如 CTR2609110001）
  contractCode        String    @unique @map("contract_code")  /// 所属房间 ID
  roomId              String    @map("room_id")
  /// 所属房间
  room                Room      @relation("ContractBelongsToRoom", fields: [roomId], references: [id], onDelete: Restrict)
  /// 所属客户 ID
  customerId          String    @map("customer_id")
  /// 所属客户
  customer            Customer  @relation("ContractBelongsToCustomer", fields: [customerId], references: [id], onDelete: Restrict)
  /// 销售经理用户 ID
  salesManagerId      String?   @map("sales_manager")
  /// 销售经理用户
  salesManagerUser    User?     @relation("ContractSalesManager", fields: [salesManagerId], references: [id], onDelete: SetNull)
  /// 关联客户需求 ID
  requirementId       String?   @map("requirement_id")
  /// 关联客户需求
  requirement         CustomerRequirement? @relation("ContractBelongsToRequirement", fields: [requirementId], references: [id], onDelete: SetNull)
  /// 合约开始日期（可由「使用期」汇总；列表筛选用）
  startDate           DateTime? @map("start_date") @db.Date
  /// 合约到期日期（可由「使用期」汇总；列表筛选用）
  endDate             DateTime? @map("end_date") @db.Date
  /// 实际退租日期
  actualEndDate       DateTime? @map("actual_end_date") @db.Date
  /// 租赁方式：整租 / 分租首用戶 / 分租次用戶
  leaseType           String    @default("") @map("lease_type")
  /// 状态：草稿 / 簽約中 / 已簽約 / 交吉中 / 租賃中 / 已完成 / 退租中 / 已退租 / 已取消 / 已續約
  status              String    @default("草稿")
  /// 房间按金
  roomDeposit         Decimal?  @map("room_deposit") @db.Decimal(14, 2)
  /// 租金/月
  monthlyRent         Decimal?  @map("monthly_rent") @db.Decimal(14, 2)
  /// 订金
  bookingDeposit      Decimal?  @map("booking_deposit") @db.Decimal(14, 2)
  /// 缴费周期：月繳 / 季繳 / 半年繳 / 年繳 等
  paymentCycle        String    @default("") @map("payment_cycle")
  /// 电费/度
  electricityRate     Decimal?  @map("electricity_rate") @db.Decimal(14, 4)
  /// 杂项按金
  miscDeposit         Decimal?  @map("misc_deposit") @db.Decimal(14, 2)
  /// 房门匙数量（押金 = 数量 × 配置单价）
  doorKeyQty          Int       @default(0) @map("door_key_qty")
  /// 房门匙按金金额（由数量 × 单价自动计算后落库）
  doorKeyDeposit      Decimal?  @map("door_key_deposit") @db.Decimal(14, 2)
  /// 智能卡信箱匙数量（押金 = 数量 × 配置单价）
  mailboxKeyQty       Int       @default(0) @map("mailbox_key_qty")
  /// 智能卡信箱匙按金金额（由数量 × 单价自动计算后落库）
  mailboxKeyDeposit   Decimal?  @map("mailbox_key_deposit") @db.Decimal(14, 2)
  /// 房间名称文本（冗余展示，可与房间名称同步）
  roomNameText        String    @default("") @map("room_name_text")
  /// 分租符号
  subleaseMark        String    @default("") @map("sublease_mark")
  /// 客户签约附件路径
  attachment          String    @default("")
  /// 备注
  remark              String    @default("")
  /// 下属合约期（使用期 / 必须使用期 / 免租期等）
  periods             ContractPeriod[] @relation("ContractPeriodBelongsToContract")
  /// 下属退租记录
  terminations        LeaseTermination[] @relation("LeaseTerminationBelongsToContract")
  /// 下属合约其他费用项（按金扣除等）
  otherFees           ContractOtherFee[] @relation("ContractOtherFeeBelongsToContract")
  /// 下属按金退还记录
  depositRefunds      DepositRefund[]    @relation("DepositRefundBelongsToContract")
  /// 下属发票
  invoices            Invoice[]          @relation("InvoiceBelongsToContract")
  /// 下属应收帐
  receivables         Receivable[]       @relation("ReceivableBelongsToContract")
  /// 下属收据
  receipts            Receipt[]          @relation("ReceiptBelongsToContract")
  /// 创建人用户 ID
  createdById         String?   @map("created_by")
  /// 创建人用户
  createdByUser       User?     @relation("ContractCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  /// 更新人用户 ID
  updatedById         String?   @map("updated_by")
  /// 更新人用户
  updatedByUser       User?     @relation("ContractUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  /// 创建时间
  createdAt           DateTime  @default(now()) @map("created_at")
  /// 更新时间
  updatedAt           DateTime  @updatedAt @map("updated_at")

  @@index([roomId])
  @@index([customerId])
  @@index([salesManagerId])
  @@index([requirementId])
  @@index([status])
  @@index([startDate])
  @@index([endDate])
  @@index([createdById])
  @@index([updatedById])
  @@map("contracts")
}

/// 合约配置字典：合约期类型 / 租赁方式 / 钥匙按金单价
model ContractConfigOption {
  /// 主键
  id          String             @id @default(cuid())
  /// 配置类型：periodType / leaseType / keyDeposit
  type        ContractConfigType
  /// 稳定业务码（同 type 下唯一；如 usage / door_key）
  code        String             @default("")
  /// 展示名称（写入合约时的文案快照）
  label       String
  /// 单价（仅 keyDeposit；其它类型为 null）
  unitPrice   Decimal?           @map("unit_price") @db.Decimal(14, 2)
  /// 排序权重，越小越靠前
  sortOrder   Int                @default(0) @map("sort_order")
  /// 是否启用（停用后表单不下拉展示）
  active      Boolean            @default(true)
  /// 创建人用户 ID
  createdById String?            @map("created_by")
  /// 创建人用户
  createdByUser User?            @relation("ContractConfigOptionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  /// 更新人用户 ID
  updatedById String?            @map("updated_by")
  /// 更新人用户
  updatedByUser User?            @relation("ContractConfigOptionUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  /// 创建时间
  createdAt   DateTime           @default(now()) @map("created_at")
  /// 更新时间
  updatedAt   DateTime           @updatedAt @map("updated_at")

  @@unique([type, code])
  @@index([type, active, sortOrder])
  @@index([createdById])
  @@index([updatedById])
  @@map("contract_config_options")
}

/// 合约期（一条合约可有多段：使用期 / 必须使用期 / 免租期等）
model ContractPeriod {
  /// 主键
  id          String   @id @default(cuid())
  /// 旧系统记录 ID（简道云 _id；工程师 JSON 导入用）
  legacyId    String?  @unique @map("legacy_id")
  /// 所属合约 ID
  contractId  String   @map("contract_id")
  /// 所属合约
  contract    Contract @relation("ContractPeriodBelongsToContract", fields: [contractId], references: [id], onDelete: Cascade)
  /// 日期类型：使用期 / 必須使用期 / 免租期
  dateType    String   @map("date_type")
  /// 日期单位：月 / 日
  dateUnit    String   @default("月") @map("date_unit")
  /// 日期数值（与单位组合表示时长，如 12 月）
  dateValue   Int      @default(0) @map("date_value")
  /// 开始日期
  startDate   DateTime @map("start_date") @db.Date
  /// 结束日期
  endDate     DateTime @map("end_date") @db.Date
  /// 排序权重，越小越靠前
  sortOrder   Int      @default(0) @map("sort_order")
  /// 创建时间
  createdAt   DateTime @default(now()) @map("created_at")
  /// 更新时间
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([contractId])
  @@index([dateType])
  @@index([startDate])
  @@index([endDate])
  @@map("contract_periods")
}

/// 退租记录（合约退租办理单）
model LeaseTermination {
  /// 主键
  id                    String   @id @default(cuid())
  /// 旧系统记录 ID（简道云 _id；工程师 JSON 导入用）
  legacyId              String?  @unique @map("legacy_id")
  /// 退租编号（业务唯一，如 TRM2609110001）
  terminationCode       String   @unique @map("termination_code")
  /// 所属合约 ID
  contractId            String   @map("contract_id")
  /// 所属合约
  contract              Contract @relation("LeaseTerminationBelongsToContract", fields: [contractId], references: [id], onDelete: Restrict)
  /// 所属客户 ID（通常与合约客户一致，可冗余便于筛选）
  customerId            String   @map("customer_id")
  /// 所属客户
  customer              Customer @relation("LeaseTerminationBelongsToCustomer", fields: [customerId], references: [id], onDelete: Restrict)
  /// 所属房间 ID（通常与合约房间一致）
  roomId                String   @map("room_id")
  /// 所属房间
  room                  Room     @relation("LeaseTerminationBelongsToRoom", fields: [roomId], references: [id], onDelete: Restrict)
  /// 退租原因
  reason                String   @default("")
  /// 退租日期
  terminationDate       DateTime? @map("termination_date") @db.Date
  /// 客户书面通知附件路径
  noticeAttachment      String   @default("") @map("notice_attachment")
  /// 房门匙已回收数量
  doorKeyReturnedQty    Int      @default(0) @map("door_key_returned_qty")
  /// 智能卡（信箱匙）已回收数量
  smartCardReturnedQty  Int      @default(0) @map("smart_card_returned_qty")
  /// 现场情况
  siteCondition         String   @default("") @map("site_condition")
  /// 备注
  remark                String   @default("")
  /// 关联退按金单编号/引用（退按金模块未落地前以文本保存）
  relatedDepositRefund  String   @default("") @map("related_deposit_refund")
  /// 下属按金扣除 / 其他费用项
  otherFees             ContractOtherFee[] @relation("ContractOtherFeeBelongsToTermination")
  /// 创建人用户 ID
  createdById           String?  @map("created_by")
  /// 创建人用户
  createdByUser         User?    @relation("LeaseTerminationCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  /// 更新人用户 ID
  updatedById           String?  @map("updated_by")
  /// 更新人用户
  updatedByUser         User?    @relation("LeaseTerminationUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  /// 创建时间
  createdAt             DateTime @default(now()) @map("created_at")
  /// 更新时间
  updatedAt             DateTime @updatedAt @map("updated_at")

  @@index([contractId])
  @@index([customerId])
  @@index([roomId])
  @@index([terminationDate])
  @@index([createdById])
  @@index([updatedById])
  @@map("lease_terminations")
}

/// 合约其他费用项（含退租按金扣除事项）
model ContractOtherFee {
  /// 主键
  id              String   @id @default(cuid())
  /// 旧系统记录 ID（简道云 _id；工程师 JSON 导入用）
  legacyId        String?  @unique @map("legacy_id")
  /// 所属合约 ID
  contractId      String   @map("contract_id")
  /// 所属合约
  contract        Contract @relation("ContractOtherFeeBelongsToContract", fields: [contractId], references: [id], onDelete: Cascade)
  /// 所属退租记录 ID（可选；退租按金扣除时填写）
  terminationId   String?  @map("termination_id")
  /// 所属退租记录
  termination     LeaseTermination? @relation("ContractOtherFeeBelongsToTermination", fields: [terminationId], references: [id], onDelete: SetNull)
  /// 描述
  description     String   @default("")
  /// 数量
  quantity        Decimal  @default(0) @db.Decimal(14, 2)
  /// 按金（单价）
  unitAmount      Decimal  @default(0) @map("unit_amount") @db.Decimal(14, 2)
  /// 小计（通常 = 数量 × 按金）
  subtotal        Decimal  @default(0) @db.Decimal(14, 2)
  /// 备注
  remark          String   @default("")
  /// 排序权重，越小越靠前
  sortOrder       Int      @default(0) @map("sort_order")
  /// 创建人用户 ID
  createdById     String?  @map("created_by")
  /// 创建人用户
  createdByUser   User?    @relation("ContractOtherFeeCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  /// 更新人用户 ID
  updatedById     String?  @map("updated_by")
  /// 更新人用户
  updatedByUser   User?    @relation("ContractOtherFeeUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  /// 创建时间
  createdAt       DateTime @default(now()) @map("created_at")
  /// 更新时间
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([contractId])
  @@index([terminationId])
  @@index([createdById])
  @@index([updatedById])
  @@map("contract_other_fees")
}

/// 按金退还记录（财务：合约退租后的按金退还办理单）
model DepositRefund {
  /// 主键
  id                  String    @id @default(cuid())
  /// 旧系统记录 ID（简道云 _id；工程师 JSON 导入用）
  legacyId            String?   @unique @map("legacy_id")
  /// 退还编号（业务唯一，如 DRF2609160001）
  refundCode          String    @unique @map("refund_code")
  /// 所属合约 ID
  contractId          String    @map("contract_id")
  /// 所属合约
  contract            Contract  @relation("DepositRefundBelongsToContract", fields: [contractId], references: [id], onDelete: Restrict)
  /// 所属客户 ID（通常与合约客户一致）
  customerId          String    @map("customer_id")
  /// 所属客户
  customer            Customer  @relation("DepositRefundBelongsToCustomer", fields: [customerId], references: [id], onDelete: Restrict)
  /// 所属房间 ID（通常与合约房间一致）
  roomId              String    @map("room_id")
  /// 所属房间
  room                Room      @relation("DepositRefundBelongsToRoom", fields: [roomId], references: [id], onDelete: Restrict)
  /// 状态（草稿 / 未退按金 / 已退按金 / 已取消）
  status              String    @default("")
  /// 退租日期
  terminationDate     DateTime? @map("termination_date") @db.Date
  /// 退款日期
  refundDate          DateTime? @map("refund_date") @db.Date
  /// 按金总额
  totalDeposit        Decimal   @default(0) @map("total_deposit") @db.Decimal(14, 2)
  /// 实退按金金额
  actualRefundAmount  Decimal   @default(0) @map("actual_refund_amount") @db.Decimal(14, 2)
  /// 处理人用户 ID
  handlerId           String?   @map("handler_id")
  /// 处理人用户
  handlerUser         User?     @relation("DepositRefundHandler", fields: [handlerId], references: [id], onDelete: SetNull)
  /// 退还凭证图片路径
  voucherImage        String    @default("") @map("voucher_image")
  /// 退还凭证附件路径
  voucherAttachment   String    @default("") @map("voucher_attachment")
  /// 备注
  remark              String    @default("")
  /// 创建人用户 ID
  createdById         String?   @map("created_by")
  /// 创建人用户
  createdByUser       User?     @relation("DepositRefundCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  /// 更新人用户 ID
  updatedById         String?   @map("updated_by")
  /// 更新人用户
  updatedByUser       User?     @relation("DepositRefundUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  /// 创建时间
  createdAt           DateTime  @default(now()) @map("created_at")
  /// 更新时间
  updatedAt           DateTime  @updatedAt @map("updated_at")
  /// 关联的应收帐（可选）
  receivables         Receivable[] @relation("ReceivableBelongsToDepositRefund")

  @@index([contractId])
  @@index([customerId])
  @@index([roomId])
  @@index([handlerId])
  @@index([status])
  @@index([terminationDate])
  @@index([refundDate])
  @@index([createdById])
  @@index([updatedById])
  @@map("deposit_refunds")
}

/// 发票（财务：合约开票记录）
model Invoice {
  /// 主键
  id                    String                 @id @default(cuid())
  /// 发票编号（可空；待开票尚未赋号时为空；有值时业务唯一，如 INV2609160001 / W250242-KT9A18）
  invoiceCode           String?                @unique @map("invoice_code")
  /// 旧系统记录 ID（简道云 _id；服务细节 JSON 按此关联所属发票）
  legacyId              String?                @unique @map("legacy_id")
  /// 所属合约 ID
  contractId            String                 @map("contract_id")
  /// 所属合约
  contract              Contract               @relation("InvoiceBelongsToContract", fields: [contractId], references: [id], onDelete: Restrict)
  /// 所属客户 ID（通常与合约客户一致）
  customerId            String                 @map("customer_id")
  /// 所属客户
  customer              Customer               @relation("InvoiceBelongsToCustomer", fields: [customerId], references: [id], onDelete: Restrict)
  /// 所属房间 ID（通常与合约房间一致）
  roomId                String                 @map("room_id")
  /// 所属房间
  room                  Room                   @relation("InvoiceBelongsToRoom", fields: [roomId], references: [id], onDelete: Restrict)
  /// 发票类型（會議室短租 / Deposit / 1, Charging Period / 10, Other charges）
  invoiceType           String                 @default("") @map("invoice_type")
  /// 发票描述
  description           String                 @default("")
  /// 开票金额
  amount                Decimal                @default(0) @db.Decimal(14, 2)
  /// 状态（待開票 / 已開票 / 已取消）
  status                String                 @default("待開票")
  /// 发票日期
  invoiceDate           DateTime?              @map("invoice_date") @db.Date
  /// 收款期限
  paymentDueDate        DateTime?              @map("payment_due_date") @db.Date
  /// 销售经理用户 ID（通常与合约销售经理一致）
  salesManagerId        String?                @map("sales_manager_id")
  /// 销售经理用户
  salesManagerUser      User?                  @relation("InvoiceSalesManager", fields: [salesManagerId], references: [id], onDelete: SetNull)
  /// 下属服务细节行
  serviceDetails        InvoiceServiceDetail[] @relation("InvoiceServiceDetailBelongsToInvoice")
  /// 下属应收帐
  receivables           Receivable[]           @relation("ReceivableBelongsToInvoice")
  /// 下属收据
  receipts              Receipt[]              @relation("ReceiptBelongsToInvoice")
  /// 应收帐引用（文本占位，兼容旧导入）
  relatedReceivableRef  String                 @default("") @map("related_receivable_ref")
  /// 开票附件路径
  attachment            String                 @default("")
  /// 房间名称文本快照
  roomNameText          String                 @default("") @map("room_name_text")
  /// 备注（业务说明）
  notes                 String                 @default("")
  /// WhatsApp 号码
  whatsappNumber        String                 @default("") @map("whatsapp_number")
  /// 短租编号（文本；会议室短租实体尚未建立）
  shortTermRentalCode   String                 @default("") @map("short_term_rental_code")
  /// 备注
  remark                String                 @default("")
  /// 创建人用户 ID
  createdById           String?                @map("created_by")
  /// 创建人用户
  createdByUser         User?                  @relation("InvoiceCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  /// 更新人用户 ID
  updatedById           String?                @map("updated_by")
  /// 更新人用户
  updatedByUser         User?                  @relation("InvoiceUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  /// 创建时间
  createdAt             DateTime               @default(now()) @map("created_at")
  /// 更新时间
  updatedAt             DateTime               @updatedAt @map("updated_at")

  @@index([contractId])
  @@index([customerId])
  @@index([roomId])
  @@index([salesManagerId])
  @@index([status])
  @@index([invoiceType])
  @@index([invoiceDate])
  @@index([paymentDueDate])
  @@index([createdById])
  @@index([updatedById])
  @@map("invoices")
}

/// 发票服务细节行（开票明细）
model InvoiceServiceDetail {
  /// 主键
  id          String   @id @default(cuid())
  /// 旧系统记录 ID（简道云 _id；工程师 JSON 导入用）
  legacyId    String?  @unique @map("legacy_id")
  /// 所属发票 ID
  invoiceId   String   @map("invoice_id")
  /// 所属发票
  invoice     Invoice  @relation("InvoiceServiceDetailBelongsToInvoice", fields: [invoiceId], references: [id], onDelete: Cascade)
  /// 服务描述
  description String   @default("")
  /// 数量
  quantity    Decimal  @default(0) @db.Decimal(14, 2)
  /// 单价
  unitAmount  Decimal  @default(0) @map("unit_amount") @db.Decimal(14, 2)
  /// 小计（通常 = 数量 × 单价）
  subtotal    Decimal  @default(0) @db.Decimal(14, 2)
  /// 备注
  remark      String   @default("")
  /// 排序权重，越小越靠前
  sortOrder   Int      @default(0) @map("sort_order")
  /// 创建人用户 ID
  createdById String?  @map("created_by")
  /// 创建人用户
  createdByUser User?  @relation("InvoiceServiceDetailCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  /// 更新人用户 ID
  updatedById String?  @map("updated_by")
  /// 更新人用户
  updatedByUser User?  @relation("InvoiceServiceDetailUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  /// 创建时间
  createdAt   DateTime @default(now()) @map("created_at")
  /// 更新时间
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([invoiceId])
  @@index([createdById])
  @@index([updatedById])
  @@map("invoice_service_details")
}

/// 应收帐（财务：发票对应的应收与回款汇总）
model Receivable {
  /// 主键
  id                 String         @id @default(cuid())
  /// 旧系统记录 ID（简道云 _id；工程师 JSON 导入用）
  legacyId           String?        @unique @map("legacy_id")
  /// 应收编号（业务唯一，如 AR2609160001）
  receivableCode     String         @unique @map("receivable_code")
  /// 所属发票 ID
  invoiceId          String         @map("invoice_id")
  /// 所属发票
  invoice            Invoice        @relation("ReceivableBelongsToInvoice", fields: [invoiceId], references: [id], onDelete: Restrict)
  /// 所属合约 ID（通常与发票合约一致）
  contractId         String         @map("contract_id")
  /// 所属合约
  contract           Contract       @relation("ReceivableBelongsToContract", fields: [contractId], references: [id], onDelete: Restrict)
  /// 所属客户 ID（通常与发票客户一致）
  customerId         String         @map("customer_id")
  /// 所属客户
  customer           Customer       @relation("ReceivableBelongsToCustomer", fields: [customerId], references: [id], onDelete: Restrict)
  /// 发票日期
  invoiceDate        DateTime?      @map("invoice_date") @db.Date
  /// 收款期限
  paymentDueDate     DateTime?      @map("payment_due_date") @db.Date
  /// 开票金额
  invoiceAmount      Decimal        @default(0) @map("invoice_amount") @db.Decimal(14, 2)
  /// 已收金额
  receivedAmount     Decimal        @default(0) @map("received_amount") @db.Decimal(14, 2)
  /// 应收金额（通常 = 开票金额 − 已收金额，可覆盖）
  receivableAmount   Decimal        @default(0) @map("receivable_amount") @db.Decimal(14, 2)
  /// 备注
  remark             String         @default("")
  /// 收款记录引用（文本占位，兼容旧导入；正式关联见 receipts）
  relatedReceiptRef  String         @default("") @map("related_receipt_ref")
  /// 下属收据
  receipts           Receipt[]      @relation("ReceiptBelongsToReceivable")
  /// 关联按金退还记录 ID（可选）
  depositRefundId    String?        @map("deposit_refund_id")
  /// 关联按金退还记录
  depositRefund      DepositRefund? @relation("ReceivableBelongsToDepositRefund", fields: [depositRefundId], references: [id], onDelete: SetNull)
  /// 创建人用户 ID
  createdById        String?        @map("created_by")
  /// 创建人用户
  createdByUser      User?          @relation("ReceivableCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  /// 更新人用户 ID
  updatedById        String?        @map("updated_by")
  /// 更新人用户
  updatedByUser      User?          @relation("ReceivableUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  /// 创建时间
  createdAt          DateTime       @default(now()) @map("created_at")
  /// 更新时间
  updatedAt          DateTime       @updatedAt @map("updated_at")

  @@index([invoiceId])
  @@index([contractId])
  @@index([customerId])
  @@index([depositRefundId])
  @@index([invoiceDate])
  @@index([paymentDueDate])
  @@index([createdById])
  @@index([updatedById])
  @@map("receivables")
}

/// 收据（财务：收款凭证记录）
model Receipt {
  /// 主键
  id                String      @id @default(cuid())
  /// 旧系统记录 ID（简道云 _id；工程师 JSON 导入用）
  legacyId          String?     @unique @map("legacy_id")
  /// 收据编号（业务唯一，如 RCP2609160001）
  receiptCode       String      @unique @map("receipt_code")
  /// 所属客户 ID
  customerId        String      @map("customer_id")
  /// 所属客户
  customer          Customer    @relation("ReceiptBelongsToCustomer", fields: [customerId], references: [id], onDelete: Restrict)
  /// 所属合约 ID（可选）
  contractId        String?     @map("contract_id")
  /// 所属合约
  contract          Contract?   @relation("ReceiptBelongsToContract", fields: [contractId], references: [id], onDelete: SetNull)
  /// 所属发票 ID（可选）
  invoiceId         String?     @map("invoice_id")
  /// 所属发票
  invoice           Invoice?    @relation("ReceiptBelongsToInvoice", fields: [invoiceId], references: [id], onDelete: SetNull)
  /// 所属应收帐 ID（可选）
  receivableId      String?     @map("receivable_id")
  /// 所属应收帐
  receivable        Receivable? @relation("ReceiptBelongsToReceivable", fields: [receivableId], references: [id], onDelete: SetNull)
  /// 收款日期
  paymentDate       DateTime?   @map("payment_date") @db.Date
  /// 收款方式（银行转账 / 支票 / 现金 / FPS 等）
  paymentMethod     String      @default("") @map("payment_method")
  /// 收款金额
  amount            Decimal     @default(0) @db.Decimal(14, 2)
  /// 备注
  remark            String      @default("")
  /// 收款凭证1路径
  voucher1          String      @default("") @map("voucher_1")
  /// 收款凭证2路径
  voucher2          String      @default("") @map("voucher_2")
  /// 修改记录（文本审计摘要）
  changeLog         String      @default("") @map("change_log")
  /// 创建人用户 ID
  createdById       String?     @map("created_by")
  /// 创建人用户
  createdByUser     User?       @relation("ReceiptCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  /// 更新人用户 ID
  updatedById       String?     @map("updated_by")
  /// 更新人用户
  updatedByUser     User?       @relation("ReceiptUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  /// 创建时间
  createdAt         DateTime    @default(now()) @map("created_at")
  /// 更新时间
  updatedAt         DateTime    @updatedAt @map("updated_at")

  @@index([customerId])
  @@index([contractId])
  @@index([invoiceId])
  @@index([receivableId])
  @@index([paymentDate])
  @@index([paymentMethod])
  @@index([createdById])
  @@index([updatedById])
  @@map("receipts")
}

/// 使用者（客户下的联系人 / 实际租赁名义人；非系统登录账号）
model Occupant {
  /// 主键
  id                  String    @id @default(cuid())
  /// 旧系统记录 ID（简道云 _id；工程师 JSON 导入用）
  legacyId            String?   @unique @map("legacy_id")
  /// 姓名
  name                String
  /// 所属客户 ID（导入时若客户编号缺失可为空）
  customerId          String?   @map("customer_id")
  /// 所属客户
  customer            Customer? @relation("OccupantBelongsToCustomer", fields: [customerId], references: [id], onDelete: SetNull)
  /// 作为主要联络人：所属客户（反向）
  primaryForCustomers Customer[] @relation("CustomerPrimaryOccupant")
  /// 客户编号（冗余，便于导入与展示）
  customerCode        String    @default("") @map("customer_code")
  /// 关联客户名称（Excel「關聯客戶」）
  relatedCustomerName String    @default("") @map("related_customer_name")
  /// WhatsApp（含区号）
  whatsapp            String    @default("")
  /// 手提电话
  mobilePhone         String    @default("") @map("mobile_phone")
  /// 联络电话
  contactPhone        String    @default("") @map("contact_phone")
  /// 电邮
  email               String    @default("")
  /// 传真
  fax                 String    @default("")
  /// 通讯地址
  address             String    @default("")
  /// 身份证号码
  idCardNo            String    @default("") @map("id_card_no")
  /// 身份证图片路径
  idCardImage         String    @default("") @map("id_card_image")
  /// 住址证明副本路径
  addressProofCopy    String    @default("") @map("address_proof_copy")
  /// 备注
  remark              String    @default("")
  /// 创建人用户 ID
  createdById         String?   @map("created_by")
  /// 创建人用户
  createdByUser       User?     @relation("OccupantCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  /// 更新人用户 ID
  updatedById         String?   @map("updated_by")
  /// 更新人用户
  updatedByUser       User?     @relation("OccupantUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  /// 创建时间
  createdAt           DateTime  @default(now()) @map("created_at")
  /// 更新时间
  updatedAt           DateTime  @updatedAt @map("updated_at")

  @@index([customerId])
  @@index([customerCode])
  @@index([name])
  @@index([createdById])
  @@index([updatedById])
  @@map("occupants")
}

/// 菜单类型
enum MenuType {
  /// 目录（一级分组）
  directory
  /// 菜单页（可路由）
  menu
}

/// 系统角色（可配置；与 User.role 枚举并存，后续可关联）
model Role {
  /// 主键
  id          String   @id @default(cuid())
  /// 角色编码（唯一，如 admin / user）
  code        String   @unique
  /// 角色名称
  name        String
  /// 角色说明
  description String   @default("")
  /// 排序（越小越靠前）
  sortOrder   Int      @default(0) @map("sort_order")
  /// 是否启用
  active      Boolean  @default(true)
  /// 是否系统内置（不可删除）
  isSystem    Boolean  @default(false) @map("is_system")
  /// 创建人用户 ID
  createdById String?  @map("created_by")
  /// 创建人用户
  createdByUser User?  @relation("RoleCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  /// 更新人用户 ID
  updatedById String?  @map("updated_by")
  /// 更新人用户
  updatedByUser User?  @relation("RoleUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  /// 创建时间
  createdAt   DateTime @default(now()) @map("created_at")
  /// 更新时间
  updatedAt   DateTime @updatedAt @map("updated_at")
  /// 下属角色菜单权限
  roleMenus   RoleMenu[]

  @@index([active])
  @@index([sortOrder])
  @@index([createdById])
  @@index([updatedById])
  @@map("roles")
}

/// 系统菜单（侧栏目录 / 页面）
model Menu {
  /// 主键
  id          String   @id @default(cuid())
  /// 上级菜单 ID（目录下挂菜单；顶级为空）
  parentId    String?  @map("parent_id")
  /// 上级菜单
  parent      Menu?    @relation("MenuTree", fields: [parentId], references: [id], onDelete: Cascade)
  /// 下属子菜单
  children    Menu[]   @relation("MenuTree")
  /// 菜单类型：directory=目录，menu=菜单页
  type        MenuType @default(menu)
  /// 显示名称（默认繁中）
  name        String
  /// i18n 键（如 menu.users；空则用 name）
  nameKey     String   @default("") @map("name_key")
  /// 前端路由 name（如 users）
  routeName   String   @default("") @map("route_name")
  /// 路由 path（相对或绝对）
  path        String   @default("")
  /// 图标标识（前端映射用）
  icon        String   @default("")
  /// 排序（越小越靠前）
  sortOrder   Int      @default(0) @map("sort_order")
  /// 是否启用
  active      Boolean  @default(true)
  /// 权限标识（预留，如 system:users）
  permission  String   @default("")
  /// 创建人用户 ID
  createdById String?  @map("created_by")
  /// 创建人用户
  createdByUser User?  @relation("MenuCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  /// 更新人用户 ID
  updatedById String?  @map("updated_by")
  /// 更新人用户
  updatedByUser User?  @relation("MenuUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  /// 创建时间
  createdAt   DateTime @default(now()) @map("created_at")
  /// 更新时间
  updatedAt   DateTime @updatedAt @map("updated_at")
  /// 下属角色菜单权限
  roleMenus   RoleMenu[]

  @@index([parentId])
  @@index([type])
  @@index([routeName])
  @@index([active])
  @@index([sortOrder])
  @@index([createdById])
  @@index([updatedById])
  @@map("menus")
}

/// 角色-菜单权限（多对多）
model RoleMenu {
  /// 所属角色 ID
  roleId String @map("role_id")
  /// 所属角色
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  /// 所属菜单 ID
  menuId String @map("menu_id")
  /// 所属菜单
  menu   Menu   @relation(fields: [menuId], references: [id], onDelete: Cascade)
  /// 创建时间
  createdAt DateTime @default(now()) @map("created_at")

  @@id([roleId, menuId])
  @@index([menuId])
  @@map("role_menus")
}

/// 单据打印模板类型
enum DocumentTemplateType {
  /// 办公室服务协议（多页 Word）
  agreement
  /// 发票
  invoice
  /// 收据
  receipt
}

/// 单据打印模板（Word .docx；按 type 区分协议/发票/收据等）
model DocumentTemplate {
  /// 主键
  id          String               @id @default(cuid())
  /// 模板名称（展示用）
  name        String
  /// 单据类型：agreement / invoice / receipt
  type        DocumentTemplateType
  /// 原始文件名
  fileName    String               @map("file_name")
  /// 存储相对路径（相对 uploads 根目录）
  storageKey  String               @map("storage_key")
  /// 是否启用
  enabled     Boolean              @default(true)
  /// 备注
  remark      String               @default("")
  /// 创建人用户 ID
  createdById String?              @map("created_by")
  /// 创建人用户
  createdByUser User?              @relation("DocumentTemplateCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  /// 更新人用户 ID
  updatedById String?              @map("updated_by")
  /// 更新人用户
  updatedByUser User?              @relation("DocumentTemplateUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  /// 创建时间
  createdAt   DateTime             @default(now()) @map("created_at")
  /// 更新时间
  updatedAt   DateTime             @updatedAt @map("updated_at")
  /// 作为协议覆盖模板的客户
  agreementCustomers Customer[]    @relation("CustomerAgreementTemplate")
  /// 选用本模板作为协议模板的大厦
  buildingsAsAgreement Building[]  @relation("BuildingAgreementTemplate")
  /// 选用本模板作为发票模板的大厦
  buildingsAsInvoice   Building[]  @relation("BuildingInvoiceTemplate")
  /// 选用本模板作为收据模板的大厦
  buildingsAsReceipt   Building[]  @relation("BuildingReceiptTemplate")

  @@index([type, enabled])
  @@index([createdById])
  @@index([updatedById])
  @@map("document_templates")
}

/// 自动编号业务键（与业务生成器绑定；合约编号为房间编号+当日日期，不走本规则）
enum NumberingBizKey {
  /// 客户编号
  customer
  /// 客户需求编号
  customerRequirement
  /// 发票编号
  invoice
  /// 收据编号
  receipt
}

/// 自动编号序号重置周期
enum NumberingResetCycle {
  /// 不重置
  none
  /// 按日重置
  daily
  /// 按月重置
  monthly
  /// 按年重置
  yearly
}

/// 自动编号规则（系统设置：客户/需求/合约/发票/收据等）
model NumberingRule {
  /// 主键
  id          String               @id @default(cuid())
  /// 业务键（与生成器绑定，唯一；复制出的备份规则可为空）
  bizKey      NumberingBizKey?     @unique @map("biz_key")
  /// 规则名称
  name        String
  /// 编号格式（%YYYY/%YY/%MM/%DD/%HH/%mm/%ss 与 %04d 序号）
  format      String
  /// 序号起始值
  startValue  Int                  @default(1) @map("start_value")
  /// 重置周期
  resetCycle  NumberingResetCycle  @default(none) @map("reset_cycle")
  /// 当前已用序号（下次取 currentSeq+1；周期重置后为 startValue-1）
  currentSeq  Int                  @default(0) @map("current_seq")
  /// 当前周期键（判断是否按周期重置，如 20260930 / 202609 / 2026）
  periodKey   String               @default("") @map("period_key")
  /// 是否启用
  active      Boolean              @default(true)
  /// 排序权重，越小越靠前
  sortOrder   Int                  @default(0) @map("sort_order")
  /// 创建人用户 ID
  createdById String?              @map("created_by")
  /// 创建人用户
  createdByUser User?              @relation("NumberingRuleCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  /// 更新人用户 ID
  updatedById String?              @map("updated_by")
  /// 更新人用户
  updatedByUser User?              @relation("NumberingRuleUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  /// 创建时间
  createdAt   DateTime             @default(now()) @map("created_at")
  /// 更新时间
  updatedAt   DateTime             @updatedAt @map("updated_at")

  @@index([active, sortOrder])
  @@index([createdById])
  @@index([updatedById])
  @@map("numbering_rules")
}

