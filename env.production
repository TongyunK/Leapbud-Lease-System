# Leapbud 租赁系统 — Docker 生产环境变量模板
# 部署前复制为 .env：Copy-Item env.production .env
# 请修改密码与 JWT_SECRET 等敏感信息

# ============================================
# PostgreSQL
# ============================================
DB_NAME=leapbud_lease
DB_USER=leapbud
DB_PASSWORD=L8pBud9kRm2xQ4nW

# ============================================
# JWT
# ============================================
JWT_SECRET=Lp9bUd2xR7LdF5gTjVn8mHcYwAeU48S7qPzD3cXbN6vF
JWT_EXPIRES_IN=7d

# ============================================
# CORS（留空则允许全部；多域名时逗号分隔，如 https://a.com,https://b.com）
# 同源经 Nginx 入口时一般无需设置
# ============================================
# CORS_ORIGIN=

# ============================================
# 后端容器内端口（一般无需修改）
# ============================================
PORT=3410
NODE_ENV=production

# ============================================
# 文件宿主机根目录（蓝绿后端共用 bind mount → 容器 /app/uploads）
# 须与旧系统「.../data」同级：其下直接是 upload/project/...
# 库内路径 /upload/project/.../xxx.pdf
#   → ${UPLOADS_HOST_PATH}/upload/project/.../xxx.pdf
# 新上传的 Word 模板：${UPLOADS_HOST_PATH}/document-templates/...
# ============================================
UPLOADS_HOST_PATH=/opt/project-deployment/leapbud-lease

# DATABASE_URL 由 docker-compose 根据上述变量自动拼接
